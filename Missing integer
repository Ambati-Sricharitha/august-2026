class Solution:
    def missingInteger(self, nums: List[int]) -> int:
        s = nums[0]

        # Find sum of longest sequential prefix
        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1] + 1:
                s += nums[i]
            else:
                break

        st = set(nums)

        # Find smallest missing integer >= sum
        while s in st:
            s += 1

        return s
        