class Solution:
    def compress(self, s):
        # code here
        n=len(s)
        lps=[0]*n
        j=0
        for i in range(1,n):
            while j and s[i]!=s[j]:
                j=lps[j-1]
            if s[i]==s[j]:
                j+=1
            lps[i]=j
        ans=[]
        i=n-1
        while i>=0:
            if i%2==1:
                length=i+1
                p=length-lps[i]
                if lps[i]>=length//2 and length%(2*p)==0:
                    ans.append('*')
                    i=i//2
                    continue
            ans.append(s[i])
            i-=1
        return ''.join(ans[::-1])
