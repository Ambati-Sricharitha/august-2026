class Solution:
    def longestRepeating(self, s, queryCharacters, queryIndices):
        n = len(s)
        a = list(s)
        ans = []

        for ch, i in zip(queryCharacters, queryIndices):
            a[i] = ch
            best = cur = 1

            for j in range(1, n):
                if a[j] == a[j-1]:
                    cur += 1
                else:
                    cur = 1
                best = max(best, cur)

            ans.append(best)

        return ans