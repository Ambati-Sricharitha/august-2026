from math import gcd
from functools import reduce

class Solution:
    def findKthSmallest(self, coins, k):
        # Remove redundant coins
        coins.sort()
        a = []
        for x in coins:
            if all(x % y != 0 for y in a):
                a.append(x)

        def lcm(x, y):
            return x // gcd(x, y) * y

        def count(n):
            ans = 0
            m = len(a)

            for mask in range(1, 1 << m):
                v = 1
                bits = 0
                for i in range(m):
                    if mask >> i & 1:
                        v = lcm(v, a[i])
                        if v > n:
                            break
                        bits += 1

                if v <= n:
                    if bits % 2:
                        ans += n // v
                    else:
                        ans -= n // v
            return ans

        lo, hi = 1, min(a) * k

        while lo < hi:
            mid = (lo + hi) // 2
            if count(mid) >= k:
                hi = mid
            else:
                lo = mid + 1

        return lo